{
  "schemaVersion": 1,
  "id": "fabricated-testmod-frapi",
  "version": "${version}",
  "name": "Fabricated Client API Test Mod",
  "description": "Exercises Fabricated's support for Fabric API's client modules on Forge (key mappings, HUD, screens and their input events, client commands) in CI. Not meant for players.",
  "authors": ["Fabricated contributors"],
  "license": "GPL-3.0",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.cmdralph.fabricated.testmod.frapi.ClientApiTestMod"]
  },
  "mixins": ["fabricated-testmod-frapi.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft_version}",
    "fabric-api-base": "*",
    "fabric-lifecycle-events-v1": "*",
    "fabric-key-mapping-api-v1": "*",
    "fabric-rendering-v1": "*",
    "fabric-screen-api-v1": "*",
    "fabric-command-api-v2": "*"
  }
}
