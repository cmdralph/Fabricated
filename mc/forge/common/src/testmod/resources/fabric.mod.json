{
  "schemaVersion": 1,
  "id": "fabricated-forge-testmod",
  "version": "${version}",
  "name": "Fabricated Forge Test Mod",
  "description": "Exercises Fabricated on Forge in CI: a Fabric mod with entrypoints and a mixin, using only the Fabric API modules Fabricated ships (the loot API). Not meant for players.",
  "authors": ["Fabricated contributors"],
  "license": "GPL-3.0",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.cmdralph.fabricated.forgetest.ForgeTestMod"],
    "server": ["io.github.cmdralph.fabricated.forgetest.ForgeTestMod"],
    "client": ["io.github.cmdralph.fabricated.forgetest.ForgeTestClient"]
  },
  "mixins": ["fabricated-forge-testmod.mixins.json"],
  "accessWidener": "fabricated-forge-testmod.classtweaker",
  "jars": [{"file": "META-INF/jars/fabricated-forge-nested.jar"}],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft_version}"
  }
}
