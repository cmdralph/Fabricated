{
  "schemaVersion": 1,
  "id": "fabricated-testmod",
  "version": "${version}",
  "name": "Fabricated Test Mod",
  "description": "Exercises Fabricated in CI. Not meant for players.",
  "authors": ["Fabricated contributors"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.cmdralph.fabricated.testmod.TestMod"${testmod_extra_main}],
    "server": ["io.github.cmdralph.fabricated.testmod.TestMod"],
    "client": ["io.github.cmdralph.fabricated.testmod.ClientTestMod"],
    "fabricated-test": ["io.github.cmdralph.fabricated.testmod.TestMod${'$'}CustomEntrypoint"],
    "modmenu": ["io.github.cmdralph.fabricated.testmod.ModMenuEntry"]
  },
  "mixins": ["fabricated-testmod.mixins.json"],
  "accessWidener": "fabricated-testmod.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "${minecraft_version}",
    "fabric-api-base": "*",
    "fabric-lifecycle-events-v1": "*"${testmod_extra_depends}
  }
}
