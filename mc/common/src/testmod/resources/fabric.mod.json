{
  "schemaVersion": 1,
  "id": "fabricated-testmod",
  "version": "${version}",
  "name": "Fabricated Test Mod",
  "description": "Exercises Fabricated in CI. Not meant for players.",
  "authors": ["Fabricated contributors"],
  "license": "GPL-3.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.cmdralph.fabricated.testmod.TestMod",
      "io.github.cmdralph.fabricated.testmod.NetworkingTest",
      "io.github.cmdralph.fabricated.testmod.ConfigurationTest",
      "io.github.cmdralph.fabricated.testmod.MenuTest",
      "io.github.cmdralph.fabricated.testmod.ResourceLoaderTest",
      "io.github.cmdralph.fabricated.testmod.RegistrySyncTest",
      "io.github.cmdralph.fabricated.testmod.EntityEventsTest",
      "io.github.cmdralph.fabricated.testmod.ObjectBuilderTest",
      "io.github.cmdralph.fabricated.testmod.BlockApiTest",
      "io.github.cmdralph.fabricated.testmod.ItemApiTest",
      "io.github.cmdralph.fabricated.testmod.InteractionTest",
      "io.github.cmdralph.fabricated.testmod.LootTest",
      "io.github.cmdralph.fabricated.testmod.ContentRegistriesTest",
      "io.github.cmdralph.fabricated.testmod.TransferTest",
      "io.github.cmdralph.fabricated.testmod.BlockEntityEventsTest"
    ],
    "server": ["io.github.cmdralph.fabricated.testmod.TestMod"],
    "client": ["io.github.cmdralph.fabricated.testmod.ClientTestMod", "io.github.cmdralph.fabricated.testmod.BlockEntityEventsClientTest"],
    "fabricated-test": ["io.github.cmdralph.fabricated.testmod.TestMod${'$'}CustomEntrypoint"],
    "modmenu": ["io.github.cmdralph.fabricated.testmod.ModMenuEntry"]
  },
  "mixins": ["fabricated-testmod.mixins.json"],
  "accessWidener": "fabricated-testmod.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "${minecraft_version}",
    "fabric-api-base": "*",
    "fabric-lifecycle-events-v1": "*",
    "fabric-networking-api-v1": "*",
    "fabric-resource-loader-v1": "*",
    "fabric-registry-sync-v0": "*",
    "fabric-entity-events-v1": "*",
    "fabric-object-builder-api-v1": "*",
    "fabric-block-api-v1": "*",
    "fabric-item-api-v1": "*",
    "fabric-events-interaction-v0": "*",
    "fabric-loot-api-v3": "*",
    "fabric-content-registries-v0": "*",
    "fabric-transfer-api-v1": "*"
  }
}
