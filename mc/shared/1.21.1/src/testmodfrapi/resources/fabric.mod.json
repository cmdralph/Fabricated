{
  "schemaVersion": 1,
  "id": "fabricated-testmod-frapi",
  "version": "${version}",
  "name": "Fabricated Client Modules Test Mod",
  "description": "Exercises Fabric API's client modules (rendering, key bindings, model loading, renderer API) on Fabricated in CI. Not meant for players.",
  "authors": ["Fabricated contributors"],
  "license": "GPL-3.0",
  "environment": "client",
  "entrypoints": {
    "main": ["io.github.cmdralph.fabricated.testmod.frapi.FrapiTestMod"],
    "client": ["io.github.cmdralph.fabricated.testmod.frapi.FrapiClientTestMod"]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "${minecraft_version}",
    "fabric-api-base": "*",
    "fabric-key-binding-api-v1": "*",
    "fabric-lifecycle-events-v1": "*",
    "fabric-model-loading-api-v1": "*",
    "fabric-networking-api-v1": "*",
    "fabric-renderer-api-v1": "*",
    "fabric-rendering-v1": "*"
  }
}
